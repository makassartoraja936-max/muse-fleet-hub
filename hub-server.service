[Unit]
Description=Muse Fleet Manager Hub Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/muse-fleet-hub/muse-fleet-manager
Environment="PORT=9000"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -u hub_server.py
Restart=always
RestartSec=3
StandardOutput=append:/var/log/hub_server.log
StandardError=append:/var/log/hub_server.err.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
